    },
    "The day with date %@ doesn't exist in your worklist, please add the day and then try to start the timer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Tag mit dem Datum %@ existiert nicht in Ihrer Arbeitsliste. Bitte fügen Sie den Tag hinzu und versuchen Sie dann, den Timer zu starten."
