    },
    "If you click 'Delete', all selected items will be deleted. Once you click 'Delete', the operation cannot be undo" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie auf 'Löschen' klicken, werden alle ausgewählten Einträge gelöscht. Nachdem Sie auf 'Löschen' geklickt haben, kann die Aktion nicht rückgängig gemacht werden."
          }
        }
      }
    },
    "If you click 'Delete', selected item will be deleted. Once you click 'Delete', the operation cannot be undo" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie auf 'Löschen' klicken, wird der ausgewählte Eintrag gelöscht. Nachdem Sie auf 'Löschen' geklickt haben, kann die Aktion nicht rückgängig gemacht werden."
          }
        }
      }
    },
    "If you don't stop the timer, overtime will begin." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du den Timer nicht stoppst, beginnt die Überzeit."
          }
        }
      }
    },
    "It's looks like your settings are not filled in correctly. Please check your settings and try again to create a workday." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Einstellungen scheinen nicht korrekt ausgefüllt zu sein. Bitte überprüfen Sie Ihre Einstellungen und versuchen Sie erneut, einen Arbeitstag zu erstellen."
          }
        }
      }
    },
    "Just One Click" : {
      "comment" : "onboarding",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
