      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer Einstellen"
          }
        }
      }
    },
    "Set your timer durations and enjoy your pauses. Just before your pause ends, you'll receive a notification. If you accidentally extend your pause by talking or getting distracted, no worries—the application will track and report this extra time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellen Sie die Dauer Ihres Timers ein und genießen Sie Ihre Pausen. Kurz bevor Ihre Pause endet, erhalten Sie eine Benachrichtigung. Wenn Sie Ihre Pause versehentlich durch Gespräche oder Ablenkungen verlängern, keine Sorge – die Anwendung wird diese zusätzliche Zeit verfolgen und melden."
          }
        }
      }
    },
